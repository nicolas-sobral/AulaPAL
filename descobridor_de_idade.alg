algoritmo "semnome"
// Função :
// Autor :
// Data : 11/03/2026
// Seção de Declarações 
var
idade, anoatual, anonascimento:inteiro
nome:caracter
inicio
escreva(" em que ano vc nasceu??? ")
leia (anonascimento)
escreva("qual teu nome? ")
leia (nome)
anoatual<-2026
idade<-anoatual-anonascimento
escreva (nome," sua idade é ",idade)
fimalgoritmo
