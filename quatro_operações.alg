algoritmo "as QUATRO OPERAÇÕES"
var
divi, mult, add, sub, num1, num2 : real

inicio
escreva("pfv, digite o primeiro número ")
leia (num1)
escreva("agora, pfv, digite o segundo número ")
leia (num2)
add<-num1+num2
sub<-num1-num2
mult<-num1*num2
divi<-num1/num2
escreva("adição ",add," subtração ",sub," multiplicação ",mult, " e divisão ", divi)
fimalgoritmo
