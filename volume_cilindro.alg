algoritmo "semnome"
// Função :
// Autor :
// Data : 18/03/2026
// Seção de Declarações 
var
r, alt,vol:real
inicio
escreva("qual o raio da circunferencia? ")
leia (r)
escreva ("e qual a altura? ")
leia(alt)
vol<-3.14159*r^2*alt
escreva ("o volume do cilindro é ", vol, " metros cúbicos")
fimalgoritmo
