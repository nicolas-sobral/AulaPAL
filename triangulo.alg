algoritmo "semnome"
// Função :
// Autor :
// Data : 25/03/2026
// Seção de Declarações 
var
alt, base, area:real
inicio
escreva("digite o valor da base do triangulo ")
leia (base)
escreva ("agora o valor da altura do triangulo ")
leia(alt)
area<-(alt*base)/2
escreva("a area desse triangulo é ",area)
fimalgoritmo
