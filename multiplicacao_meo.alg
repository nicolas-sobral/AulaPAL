algoritmo "multipricacao_meo"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações 
var
multiplicacao, numero1, numero2: inteiro
inicio
escreva("fale meu fi o primeiro numero: ")
leia (numero1)
escreva("agora o segundo moço: ")
leia (numero2)
multiplicacao<-numero1*numero2
escreva("o resultado é ", multiplicacao , "meo")
fimalgoritmo
