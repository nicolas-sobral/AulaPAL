algoritmo "dilivisao_meo"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações 
var
divisao, numero1, numero2: real
inicio
escreva("fale meu fi o primeiro numero: ")
leia (numero1)
escreva("agora o segundo moço: ")
leia (numero2)
divisao<-numero1/numero2
escreva("o resultado é ", divisao , " meo")
fimalgoritmo
