algoritmo "semnome"
// Função :
// Autor :
// Data : 25/03/2026
// Seção de Declarações 
var
valor,venda:real
inicio
escreva("digite o valor do produto: ")
leia(valor)
se(valor<=20.00)entao
venda<-valor*45/100+valor
escreva("o valor da venda do produto será de ", venda)
senao
venda<-valor*30/100+valor
escreva("o valor da venda do produto será de ", venda)
fimse
fimalgoritmo
