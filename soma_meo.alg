algoritmo "soma_meeeeeeeeeeeeeoooooooooooo"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações 
var
calculo, numero1,numero2: inteiro
inicio
escreva ("fale o primeiro numero meu fi: ")
leia(numero1)
escreva ("fale o segundo numero mano: ")
leia (numero2)
calculo <- numero1 + numero2
escreva ("o resultado da soma meu fi é: ", calculo)
fimalgoritmo
