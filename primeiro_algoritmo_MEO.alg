algoritmo "primeiro_algoritmo"
// Função :nenhuma
// Autor :nicolau copenso
// Data : 04/03/2026
// Seção de Declarações 
var
     nome: caracter
     idade: inteiro
inicio
escreva ("escreva seu nome: ")
leia(nome)
escreva("qual sua idade meo?????? ")
leia(idade)
escreva("o seu nome é: ", nome)
escreva("sua idade é: ", idade, " meo")
fimalgoritmo
