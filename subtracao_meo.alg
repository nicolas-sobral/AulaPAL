algoritmo "mwehehehehhehehehehe"
// Função :
// Autor :
// Data : 04/03/2026
// Seção de Declarações 
var
subtracao,numero1,numero2: inteiro
inicio
escreva ("e moço, fale o primeiro numero: ")
leia(numero1)
escreva("agora moço, fale o segundo: ")
leia(numero2)
subtracao <-numero1-numero2
escreva("moço, o resultado é: ", subtracao)
fimalgoritmo
